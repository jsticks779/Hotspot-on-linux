#!/usr/bin/env bash
#
# linux-hotspot — share your internet over Wi-Fi, even when the internet you
# are sharing arrives over that same Wi-Fi card.
#
# https://github.com/jsticks779/Hotspot-on-linux
#
# Licensed under the MIT license.

set -uo pipefail

VERSION=1.0.0

# ---------------------------------------------------------------- constants --
CONF_DIR=/etc/linux-hotspot
CONF="$CONF_DIR/hotspot.conf"
RUN_CONF=/run/linux-hotspot-hostapd.conf
HOSTAPD_PID=/run/linux-hotspot-hostapd.pid
DNSMASQ_PID=/run/linux-hotspot-dnsmasq.pid
FORWARD_SAVE=/run/linux-hotspot.ip_forward
UPLINK_SAVE=/run/linux-hotspot.uplink
LEASES=/var/lib/misc/linux-hotspot.leases
NFT_TABLE=linux_hotspot
EXT_UUID="linux-hotspot@jsticks779.github.io"

# ----------------------------------------------------------------- defaults --
# Every one of these can be overridden in /etc/linux-hotspot/hotspot.conf
SSID="linux-hotspot"
PASSPHRASE=""
SECURITY="wpa2"          # wpa2 | wpa3 | mixed
AP_IFACE="ap0"
AP_MAC=""                # empty: inherit the card's MAC
AP_PHY=""                # empty: auto (a second radio if there is one)
STA_IFACE=""             # empty: auto-detect
UPLINK_IFACE=""          # empty: auto-detect (the default route)
CHANNEL=""               # empty: auto (forced to the client channel when sharing Wi-Fi)
COUNTRY=""               # empty: auto from the regulatory domain
IPV4_NET="10.42.0"       # a /24; the host takes .1
DHCP_FIRST=10
DHCP_LAST=100
DNS_SERVERS="1.1.1.1,8.8.8.8"
HIDDEN=0

# ------------------------------------------------------------------- output --
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RESET=$'\033[0m'; C_RED=$'\033[31m'; C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
else
    C_RESET=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_BLUE=""; C_DIM=""; C_BOLD=""
fi

log()  { echo "${C_BLUE}::${C_RESET} $*"; logger -t linux-hotspot -- "$*" 2>/dev/null || true; }
warn() { echo "${C_YELLOW}warning:${C_RESET} $*" >&2; logger -t linux-hotspot -- "warning: $*" 2>/dev/null || true; }
die()  { echo "${C_RED}error:${C_RESET} $*" >&2; logger -t linux-hotspot -- "error: $*" 2>/dev/null || true; exit 1; }
ok()   { echo "${C_GREEN}✓${C_RESET} $*"; }
bad()  { echo "${C_RED}✗${C_RESET} $*"; }
meh()  { echo "${C_YELLOW}!${C_RESET} $*"; }

need_root() { [ "$(id -u)" = 0 ] || die "this command needs root — try: sudo linux-hotspot $*"; }

validate_credentials() {
    if [ ${#SSID} -lt 1 ] || [ ${#SSID} -gt 32 ]; then
        die "the network name must be 1-32 characters"
    fi
    if [ ${#PASSPHRASE} -lt 8 ] || [ ${#PASSPHRASE} -gt 63 ]; then
        die "the password must be 8-63 characters"
    fi
}

# ------------------------------------------------------------ configuration --
# Parsed rather than sourced: the file is writable by the desktop user so the
# GNOME toggle can edit it, and that must never become a way to run code as root.
load_conf() {
    [ -r "$CONF" ] || return 0
    local key val
    while IFS='=' read -r key val; do
        val=${val%$'\r'}
        val=${val#\"}; val=${val%\"}
        val=${val#\'}; val=${val%\'}
        case "$key" in
            SSID|PASSPHRASE|SECURITY|AP_IFACE|AP_MAC|AP_PHY|STA_IFACE|UPLINK_IFACE|\
            CHANNEL|COUNTRY|IPV4_NET|DHCP_FIRST|DHCP_LAST|DNS_SERVERS|HIDDEN)
                printf -v "$key" '%s' "$val" ;;
        esac
    done < <(grep -E '^[A-Z_]+=' "$CONF" 2>/dev/null)
}

write_conf() {
    mkdir -p "$CONF_DIR"
    local tmp="$CONF.tmp.$$"
    cat > "$tmp" <<EOF
# linux-hotspot configuration — see \`linux-hotspot help\` and the project docs.
# Anything left commented out is detected automatically at start time.

SSID=$SSID
PASSPHRASE=$PASSPHRASE

# wpa2 (works everywhere) | wpa3 (modern devices only) | mixed
SECURITY=$SECURITY

# Force settings only if auto-detection picks the wrong thing:
#STA_IFACE=wlan0
#UPLINK_IFACE=eth0
#AP_IFACE=ap0
#AP_MAC=02:11:22:33:44:55
#AP_PHY=phy1           # host on a second radio: any channel, always available
#CHANNEL=6
#COUNTRY=US
#IPV4_NET=10.42.0
#DNS_SERVERS=1.1.1.1,8.8.8.8
#HIDDEN=0
EOF
    chmod 0660 "$tmp"
    mv "$tmp" "$CONF"
    # The desktop user needs write access for the quick-settings password editor.
    local owner
    owner=$(stat -c '%G' "$CONF_DIR" 2>/dev/null)
    [ -n "$owner" ] && chgrp "$owner" "$CONF" 2>/dev/null
    return 0
}

# -------------------------------------------------------------- detection ----
wifi_ifaces() { iw dev 2>/dev/null | awk '$1=="Interface"{print $2}'; }

iface_type() { iw dev "$1" info 2>/dev/null | awk '$1=="type"{print $2}'; }

detect_sta() {
    if [ -n "$STA_IFACE" ]; then echo "$STA_IFACE"; return 0; fi
    local i
    # prefer a card that is actually associated with a network
    for i in $(wifi_ifaces); do
        [ "$i" = "$AP_IFACE" ] && continue
        if iw dev "$i" link 2>/dev/null | grep -q "^Connected to"; then
            echo "$i"; return 0
        fi
    done
    for i in $(wifi_ifaces); do
        [ "$i" = "$AP_IFACE" ] && continue
        if [ "$(iface_type "$i")" = "managed" ]; then echo "$i"; return 0; fi
    done
    return 1
}

detect_uplink() {
    if [ -n "$UPLINK_IFACE" ]; then echo "$UPLINK_IFACE"; return 0; fi
    ip route show default 2>/dev/null | awk '/^default/{print $5; exit}'
}

sta_phy()     { iw dev "$1" info 2>/dev/null | awk '$1=="wiphy"{print "phy"$2}'; }
sta_channel() { iw dev "$1" info 2>/dev/null | awk '$1=="channel"{print $2}'; }
sta_freq()    { iw dev "$1" info 2>/dev/null | awk '$1=="channel"{gsub(/[()]/,"",$3); print $3}'; }

# Cards with a self-managed regulatory domain (most iwlwifi) carry their own,
# and it overrides the global one — it is what actually governs whether we may
# transmit. Ask the radio first, and only fall back to the system-wide answer.
detect_country() {
    if [ -n "$COUNTRY" ]; then echo "$COUNTRY"; return 0; fi

    local phy="${1:-}" sta c=""
    if [ -z "$phy" ]; then
        sta=$(detect_sta) && phy=$(sta_phy "$sta")
    fi
    if [ -n "$phy" ]; then
        c=$(iw phy "$phy" reg get 2>/dev/null | awk '/^country/{gsub(":","",$2); print $2; exit}')
    fi
    if [ -z "$c" ] || [ "$c" = "00" ]; then
        c=$(iw reg get 2>/dev/null | awk '/^country/{gsub(":","",$2); print $2; exit}')
    fi
    if [ -n "$c" ] && [ "$c" != "00" ]; then echo "$c"; return 0; fi
    echo "US"
}

phy_supports_ap() { iw phy "$1" info 2>/dev/null | grep -qE '^[[:space:]]*\* AP$'; }

# Glob rather than `ls`: on systems where ls is a wrapper (eza and friends) it
# decorates symlinks and the output stops being a plain list of names.
wifi_phys() {
    local p
    for p in /sys/class/ieee80211/*; do
        [ -e "$p" ] || continue
        printf '%s\n' "${p##*/}"
    done
}

# Which radio should host the hotspot? A radio other than the one carrying our
# internet is worth far more than the built-in one: it has its own channel, so
# the hotspot no longer has to follow the client link, and no regulator rule
# about the client's channel applies to it. A USB dongle is enough.
pick_ap_phy() {
    local sta_phy=$1 p
    if [ -n "$AP_PHY" ]; then echo "$AP_PHY"; return 0; fi
    for p in $(wifi_phys); do
        [ "$p" = "$sta_phy" ] && continue
        if phy_supports_ap "$p"; then echo "$p"; return 0; fi
    done
    echo "$sta_phy"
}

# Regulatory rules decide more than which channels exist: many countries mark
# 5 GHz channels "no IR" (no initiating radiation), meaning the card may *join*
# a network there but never *create* one. hostapd refuses those outright, so
# check before we spend half a minute retrying.
#   iw prints lines like:  * 5180.0 MHz [36] (22.0 dBm) (no IR)
chan_allows_ap() {
    local chan=$1 phy=$2
    iw phy "$phy" info 2>/dev/null | awk -v want="[$chan]" '
        $1 == "*" && $3 == "MHz" && $4 == want {
            print ($0 ~ /no IR/ || $0 ~ /disabled/) ? "no" : "yes"
            found = 1; exit
        }
        END { if (!found) print "unknown" }'
}

# Networks in range that sit on a channel we are allowed to host on. Saved ones
# come first, since joining those is a single click. Only consulted when we have
# already failed, so the scan cost does not matter.
hostable_networks_in_range() {
    local phy=$1 allowed saved
    command -v nmcli >/dev/null 2>&1 || return 0
    allowed=$(ap_capable_channels "$phy")
    [ -n "$allowed" ] || return 0
    saved=$(nmcli -t -f NAME connection show 2>/dev/null)

    nmcli -t -f SSID,CHAN,SIGNAL device wifi list 2>/dev/null |
    awk -F: -v ok="$allowed" -v saved="$saved" '
        BEGIN {
            n = split(ok, a, " ");   for (i = 1; i <= n; i++) good[a[i]] = 1
            m = split(saved, s, "\n"); for (i = 1; i <= m; i++) known[s[i]] = 1
        }
        $1 != "" && good[$2] && !seen[$1]++ {
            printf "%s|%s|%s|%s\n", (known[$1] ? "saved" : "open"), $1, $2, $3
        }' | sort -t'|' -k4,4nr | head -4
}

# Channels this card may actually start an access point on, right now.
ap_capable_channels() {
    iw phy "$1" info 2>/dev/null | awk '
        $1 == "*" && $3 == "MHz" && $0 !~ /no IR/ && $0 !~ /disabled/ {
            gsub(/[][]/, "", $4)
            if ($4 != "") printf "%s ", $4
        }'
}

# The "valid interface combinations" block says what the driver will run at the
# same time. Each combination can wrap onto a second line, so glue them back
# into one line each before anybody tries to read them.
phy_combinations() {
    iw phy "$1" info 2>/dev/null | awk '
        /valid interface combinations/ { inblock = 1; next }
        inblock && /^\t[^\t]/          { exit }
        inblock {
            gsub(/^[ \t]+/, "")
            if ($0 ~ /^\*/) { if (line != "") print line; line = $0 }
            else            { line = line " " $0 }
        }
        END { if (line != "") print line }
    '
}

# The combination that mentions AP, if the driver offers one at all.
phy_ap_combination() { phy_combinations "$1" | grep -m1 '\bAP\b'; }

fw_backend() {
    if command -v iptables >/dev/null 2>&1 && iptables -t nat -S >/dev/null 2>&1; then
        echo iptables
    elif command -v nft >/dev/null 2>&1; then
        echo nft
    else
        echo none
    fi
}

# --------------------------------------------------------------- firewall ----
firewall_up() {
    local sta=$1 net="$IPV4_NET.0/24" backend
    backend=$(fw_backend)

    # Remember which interface we masqueraded out of. By the time we tear down,
    # the default route may point somewhere else entirely (someone plugged in
    # ethernet), and deleting rules for the wrong interface would leave the real
    # ones behind.
    echo "$sta" > "$UPLINK_SAVE"

    if [ ! -f "$FORWARD_SAVE" ]; then
        sysctl -n net.ipv4.ip_forward > "$FORWARD_SAVE" 2>/dev/null || echo 0 > "$FORWARD_SAVE"
    fi
    sysctl -qw net.ipv4.ip_forward=1

    case "$backend" in
        iptables)
            iptables -t nat -C POSTROUTING -s "$net" -o "$sta" -j MASQUERADE 2>/dev/null || \
                iptables -t nat -A POSTROUTING -s "$net" -o "$sta" -j MASQUERADE
            iptables -C FORWARD -i "$AP_IFACE" -o "$sta" -j ACCEPT 2>/dev/null || \
                iptables -I FORWARD 1 -i "$AP_IFACE" -o "$sta" -j ACCEPT
            iptables -C FORWARD -i "$sta" -o "$AP_IFACE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || \
                iptables -I FORWARD 1 -i "$sta" -o "$AP_IFACE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
            # keep TCP inside the tunnel-ish MTU of whatever the uplink is
            iptables -t mangle -C FORWARD -o "$sta" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || \
                iptables -t mangle -A FORWARD -o "$sta" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
            ;;
        nft)
            nft delete table ip "$NFT_TABLE" 2>/dev/null
            nft add table ip "$NFT_TABLE"
            nft add chain ip "$NFT_TABLE" postrouting "{ type nat hook postrouting priority 100 ; }"
            nft add rule  ip "$NFT_TABLE" postrouting ip saddr "$net" oifname "$sta" masquerade
            nft add chain ip "$NFT_TABLE" forward "{ type filter hook forward priority -10 ; }"
            nft add rule  ip "$NFT_TABLE" forward iifname "$AP_IFACE" oifname "$sta" accept
            nft add rule  ip "$NFT_TABLE" forward iifname "$sta" oifname "$AP_IFACE" ct state related,established accept
            ;;
        *)
            warn "no iptables or nft found — clients will associate but get no internet"
            ;;
    esac
}

firewall_down() {
    local sta=$1 net="$IPV4_NET.0/24"
    case "$(fw_backend)" in
        iptables)
            iptables -t nat -D POSTROUTING -s "$net" -o "$sta" -j MASQUERADE 2>/dev/null
            iptables -D FORWARD -i "$AP_IFACE" -o "$sta" -j ACCEPT 2>/dev/null
            iptables -D FORWARD -i "$sta" -o "$AP_IFACE" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null
            iptables -t mangle -D FORWARD -o "$sta" -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null
            ;;
        nft)
            nft delete table ip "$NFT_TABLE" 2>/dev/null
            ;;
    esac
    if [ -f "$FORWARD_SAVE" ]; then
        sysctl -qw "net.ipv4.ip_forward=$(cat "$FORWARD_SAVE")" 2>/dev/null
        rm -f "$FORWARD_SAVE"
    fi
    rm -f "$UPLINK_SAVE"
    return 0
}

# ----------------------------------------------------------------- hostapd ---
write_hostapd_conf() {
    local chan=$1 hw=$2 phy=$3
    {
        echo "interface=$AP_IFACE"
        echo "driver=nl80211"
        echo "ctrl_interface=/run/hostapd"
        echo "ssid=$SSID"
        echo "country_code=$(detect_country "$phy")"
        echo "ieee80211d=1"
        echo "hw_mode=$hw"
        echo "channel=$chan"
        # Deliberately 20 MHz: asking for HT40 makes hostapd run a coexistence
        # scan, and on a single radio that scan fights the client link and dies
        # with EBUSY. Bandwidth is rarely the bottleneck when re-sharing Wi-Fi.
        echo "ieee80211n=1"
        [ "$hw" = "a" ] && { echo "ieee80211ac=1"; echo "vht_oper_chwidth=0"; }
        echo "wmm_enabled=1"
        echo "auth_algs=1"
        echo "macaddr_acl=0"
        echo "ignore_broadcast_ssid=$HIDDEN"
        echo "wpa=2"
        echo "rsn_pairwise=CCMP"
        case "$SECURITY" in
            wpa3)
                echo "wpa_key_mgmt=SAE"
                echo "ieee80211w=2"
                echo "sae_password=$PASSPHRASE"
                ;;
            mixed)
                echo "wpa_key_mgmt=WPA-PSK SAE"
                echo "ieee80211w=1"
                echo "sae_password=$PASSPHRASE"
                echo "wpa_passphrase=$PASSPHRASE"
                ;;
            *)
                echo "wpa_key_mgmt=WPA-PSK"
                echo "wpa_passphrase=$PASSPHRASE"
                ;;
        esac
    } > "$RUN_CONF"
    chmod 600 "$RUN_CONF"
}

# hostapd -B forks before the radio is really up, so its exit status proves
# nothing. The interface advertising an SSID is the only honest success signal.
wait_for_beacon() {
    local i
    for i in $(seq 1 12); do
        iw dev "$AP_IFACE" info 2>/dev/null | grep -q "^[[:space:]]*ssid " && return 0
        if [ -f "$HOSTAPD_PID" ] && ! kill -0 "$(cat "$HOSTAPD_PID")" 2>/dev/null; then
            return 1
        fi
        sleep 0.5
    done
    return 1
}

# Bringing the AP up races the client link's background scans and comes back
# EBUSY often enough that a single attempt is not good enough.
start_hostapd() {
    local attempt
    for attempt in 1 2 3 4; do
        hostapd -B -P "$HOSTAPD_PID" "$RUN_CONF"
        wait_for_beacon && return 0
        log "hostapd attempt $attempt failed (radio busy) — retrying"
        [ -f "$HOSTAPD_PID" ] && { kill "$(cat "$HOSTAPD_PID")" 2>/dev/null; rm -f "$HOSTAPD_PID"; }
        ip link set "$AP_IFACE" down 2>/dev/null
        sleep 2
    done
    return 1
}

ap_mode_ok() { iw dev "$AP_IFACE" info 2>/dev/null | grep -q "type AP"; }

is_running() { [ -f "$HOSTAPD_PID" ] && kill -0 "$(cat "$HOSTAPD_PID")" 2>/dev/null; }

create_ap_iface() {
    local phy=$1
    if ! iw dev "$AP_IFACE" info >/dev/null 2>&1; then
        iw phy "$phy" interface add "$AP_IFACE" type __ap 2>/dev/null || \
            die "could not create $AP_IFACE on $phy — does this card support AP mode? try: linux-hotspot doctor"
        sleep 1   # the driver needs a beat before it will accept a mode change
    fi
    # Several drivers (iwlwifi especially) hand back a "managed" interface even
    # when asked for AP, and refuse the change while the link is up.
    if ! ap_mode_ok; then
        ip link set "$AP_IFACE" down 2>/dev/null
        local i
        for i in 1 2 3 4 5; do
            iw dev "$AP_IFACE" set type __ap 2>/dev/null && ap_mode_ok && break
            sleep 0.5
        done
    fi
    ap_mode_ok || die "$AP_IFACE would not switch into AP mode"

    if [ -n "$AP_MAC" ]; then
        ip link set "$AP_IFACE" down 2>/dev/null
        ip link set "$AP_IFACE" address "$AP_MAC" 2>/dev/null || \
            warn "the driver refused AP_MAC=$AP_MAC — continuing with the card's own address"
    fi
}

wait_for_sta() {
    local sta=$1 i
    for i in $(seq 1 25); do
        [ -n "$(sta_channel "$sta")" ] && return 0
        sleep 1
    done
    return 1
}

require_tools() {
    local missing=""
    for t in iw hostapd dnsmasq ip; do
        command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
    done
    [ -z "$missing" ] || die "missing required tools:$missing (re-run the installer, or install them with your package manager)"
}

# --------------------------------------------------------------------- up ----
cmd_up() {
    need_root up
    load_conf
    require_tools

    # Starting something that is already up must be harmless: systemd, the
    # desktop toggle and a hand-typed `linux-hotspot up` can all race here.
    if is_running; then
        log "already running — nothing to do"
        return 0
    fi
    # Leftovers from a crash, or from a run outside systemd, would make hostapd
    # fail with "interface already in use". Clear them out first.
    if [ -e "$HOSTAPD_PID" ] || [ -e "$DNSMASQ_PID" ] || iw dev "$AP_IFACE" info >/dev/null 2>&1; then
        cmd_down >/dev/null 2>&1
    fi

    [ -n "$PASSPHRASE" ] || die "no password set — run: sudo linux-hotspot config --password 'your-password'"
    case "$SECURITY" in
        wpa2|wpa3|mixed) ;;
        *) die "SECURITY must be wpa2, wpa3 or mixed (got '$SECURITY')" ;;
    esac
    validate_credentials

    local sta phy ap_phy uplink chan hw freq mode
    sta=$(detect_sta) || die "no Wi-Fi interface found"
    [ -n "$sta" ] || die "no Wi-Fi interface found — is the card present and the driver loaded?"
    phy=$(sta_phy "$sta")
    [ -n "$phy" ] || die "cannot work out which radio $sta belongs to"
    ap_phy=$(pick_ap_phy "$phy")
    uplink=$(detect_uplink)

    # If the only possible source of internet is the Wi-Fi link itself, it is
    # worth waiting for it to associate — at boot we can easily be here before
    # NetworkManager has finished connecting.
    if [ -z "$uplink" ] || [ "$uplink" = "$sta" ]; then
        wait_for_sta "$sta" || \
            die "$sta is not connected to any Wi-Fi network — join one first, then start the hotspot"
    fi

    # The channel is dictated by the *radio*, not by where the internet comes
    # from. If the card is associated with a network — even when the internet
    # arrives over ethernet — the AP has to sit on that same channel, because
    # one radio cannot be tuned to two channels at once.
    #
    # Unless the hotspot has a radio of its own, in which case none of that
    # applies and the channel is simply ours to pick.
    if [ "$ap_phy" != "$phy" ]; then
        chan=${CHANNEL:-6}
        case "$chan" in
            ''|*[!0-9]*) die "CHANNEL must be a number (got '$chan')" ;;
        esac
        if [ "$chan" -le 14 ]; then hw=g; else hw=a; fi
        log "hosting on $ap_phy, its own radio — independent of $sta's channel"
    else
    chan=$(sta_channel "$sta")
    if [ -n "$chan" ]; then
        freq=$(sta_freq "$sta")
        if [ -n "$freq" ] && [ "$freq" -lt 3000 ]; then hw=g; else hw=a; fi
        if [ -n "$CHANNEL" ] && [ "$CHANNEL" != "$chan" ]; then
            warn "ignoring CHANNEL=$CHANNEL — $sta is associated on channel $chan and the radio must stay there"
        fi
    else
        # The card is idle, so the channel is ours to choose.
        chan=${CHANNEL:-6}
        case "$chan" in
            ''|*[!0-9]*) die "CHANNEL must be a number (got '$chan')" ;;
        esac
        if [ "$chan" -le 14 ]; then hw=g; else hw=a; fi
    fi
    fi

    if [ -z "$uplink" ]; then
        warn "no default route — the hotspot will work but has no internet to share"
        mode="nothing → wi-fi"
    elif [ "$uplink" = "$sta" ]; then
        mode="wi-fi → wi-fi"
    else
        mode="$uplink → wi-fi"
    fi

    # Fail here, with an explanation, rather than letting hostapd retry four
    # times and die with "Could not select hw_mode and channel".
    if [ "$(chan_allows_ap "$chan" "$ap_phy")" = "no" ]; then
        local usable
        usable=$(ap_capable_channels "$ap_phy")
        warn "channel $chan is receive-only under $(detect_country "$ap_phy") regulations —"
        warn "a card may join a network there, but not start one."
        if [ -n "$usable" ]; then
            warn "channels this card can host on: $usable"
        fi
        if [ "${uplink:-}" = "$sta" ] && [ "$ap_phy" = "$phy" ]; then
            # Name the way out, rather than leaving it as an exercise.
            local candidates tag ssid cch sig
            candidates=$(hostable_networks_in_range "$ap_phy")
            if [ -n "$candidates" ]; then
                warn "networks in range you could host on instead:"
                while IFS='|' read -r tag ssid cch sig; do
                    [ -n "$ssid" ] || continue
                    if [ "$tag" = "saved" ]; then
                        warn "  $ssid — channel $cch, ${sig}% (already saved: nmcli connection up \"$ssid\")"
                    else
                        warn "  $ssid — channel $cch, ${sig}%"
                    fi
                done <<EOF
$candidates
EOF
            fi
            die "the hotspot cannot run while $sta is on channel $chan"
        fi
        die "pick an allowed channel: sudo linux-hotspot config --channel N"
    fi

    create_ap_iface "$ap_phy"
    ip addr replace "$IPV4_NET.1/24" dev "$AP_IFACE"
    ip link set "$AP_IFACE" up >/dev/null 2>&1   # hostapd does this too; EBUSY here is harmless

    write_hostapd_conf "$chan" "$hw" "$ap_phy"
    if ! start_hostapd; then
        cmd_down >/dev/null 2>&1
        die "hostapd would not start on channel $chan ($hw) — debug with: hostapd -d $RUN_CONF"
    fi

    mkdir -p "$(dirname "$LEASES")"
    local dns_args="" d
    for d in ${DNS_SERVERS//,/ }; do dns_args="$dns_args --server=$d"; done
    # shellcheck disable=SC2086
    if ! dnsmasq --pid-file="$DNSMASQ_PID" \
            --interface="$AP_IFACE" --bind-interfaces --except-interface=lo \
            --dhcp-range="$IPV4_NET.$DHCP_FIRST,$IPV4_NET.$DHCP_LAST,255.255.255.0,12h" \
            --dhcp-option=3,"$IPV4_NET.1" --dhcp-option=6,"$IPV4_NET.1" \
            --dhcp-leasefile="$LEASES" --no-hosts --no-resolv $dns_args; then
        cmd_down >/dev/null 2>&1
        die "dnsmasq failed to start — is another DHCP or DNS server already bound to $AP_IFACE?"
    fi

    firewall_up "${uplink:-$sta}"
    local band; [ "$hw" = "g" ] && band="2.4 GHz" || band="5 GHz"
    log "up: \"$SSID\" on channel $chan ($band), sharing $mode"
}

# ------------------------------------------------------------------- down ----
cmd_down() {
    need_root down
    load_conf

    # Prefer the interface we actually masqueraded out of, recorded at start.
    local sta pidfile
    if [ -r "$UPLINK_SAVE" ]; then
        sta=$(cat "$UPLINK_SAVE")
    else
        sta=$(detect_uplink)
        [ -n "$sta" ] || sta=$(detect_sta)
    fi

    for pidfile in "$DNSMASQ_PID" "$HOSTAPD_PID"; do
        if [ -f "$pidfile" ]; then
            kill "$(cat "$pidfile")" 2>/dev/null
            rm -f "$pidfile"
        fi
    done
    sleep 1
    firewall_down "${sta:-}"
    iw dev "$AP_IFACE" del 2>/dev/null
    rm -f "$RUN_CONF"
    log "down"
    return 0
}

# Prefer systemd when it owns the hotspot, so its idea of the state stays true.
hotspot_stop() {
    if command -v systemctl >/dev/null 2>&1 && systemctl cat linux-hotspot.service >/dev/null 2>&1; then
        systemctl stop linux-hotspot.service
    else
        cmd_down >/dev/null 2>&1
    fi
}

hotspot_start() {
    if command -v systemctl >/dev/null 2>&1 && systemctl cat linux-hotspot.service >/dev/null 2>&1; then
        systemctl start linux-hotspot.service
    else
        cmd_up
    fi
}

# ------------------------------------------------------------------- roam ----
# Joining a different network while the hotspot is running is impossible on a
# single radio: the AP holds the channel, and the client cannot associate on a
# different one. So step out of the way, wait for the new link, come back on
# whatever channel it landed on.
cmd_roam() {
    need_root roam
    load_conf

    local timeout="${1:-120}" sta before now saw_gap=0 i
    case "$timeout" in
        ''|*[!0-9]*) die "roam takes a number of seconds, e.g. linux-hotspot roam 60" ;;
    esac

    sta=$(detect_sta) || die "no Wi-Fi interface found"
    before=$(iw dev "$sta" link 2>/dev/null | awk '/^Connected to/{print $3}')

    log "pausing the hotspot so the radio is free to change channel"
    hotspot_stop

    echo
    echo "  ${C_BOLD}Join the Wi-Fi network you want now${C_RESET} — from your desktop, or with nmcli."
    echo "  ${C_DIM}Waiting up to ${timeout}s; the hotspot then returns on the new channel.${C_RESET}"
    echo

    for i in $(seq 1 "$timeout"); do
        now=$(iw dev "$sta" link 2>/dev/null | awk '/^Connected to/{print $3}')
        [ -z "$now" ] && saw_gap=1
        # a different access point, or the same one after a real disconnect
        if [ -n "$now" ] && { [ "$now" != "$before" ] || [ "$saw_gap" = 1 ]; }; then
            sleep 2   # let the link settle before reading the channel off it
            log "joined $(iw dev "$sta" link 2>/dev/null | awk '/^SSID:/{print $2}') on channel $(sta_channel "$sta")"
            hotspot_start
            return 0
        fi
        sleep 1
    done

    warn "nothing new joined within ${timeout}s — putting the hotspot back as it was"
    hotspot_start
}

# ----------------------------------------------------------------- status ----
cmd_status() {
    load_conf
    if [ -f "$HOSTAPD_PID" ] && kill -0 "$(cat "$HOSTAPD_PID")" 2>/dev/null; then
        local chan clients
        chan=$(iw dev "$AP_IFACE" info 2>/dev/null | awk '$1=="channel"{gsub(/[(),]/,"",$3); print $2 " (" $3 " MHz)"}')
        clients=$(iw dev "$AP_IFACE" station dump 2>/dev/null | grep -c '^Station')
        echo "${C_GREEN}● running${C_RESET}"
        echo "  network   $SSID"
        echo "  security  $SECURITY"
        echo "  channel   ${chan:-unknown}"
        echo "  address   $IPV4_NET.1/24"
        echo "  clients   ${clients:-0}"
        if [ -s "$LEASES" ]; then
            echo "  leases"
            awk '{printf "            %-16s %s\n", $3, ($4=="*" ? "(no name)" : $4)}' "$LEASES"
        fi
        return 0
    fi
    echo "${C_DIM}○ stopped${C_RESET}"
    echo "  network   $SSID"
    return 1
}

# NetworkManager has a hotspot of its own — GNOME Settings' "Turn On Wi-Fi
# Hotspot" switch. It converts the *client* interface into an access point,
# which drops the very connection we are sharing, and it often reuses the same
# network name so the result looks right while carrying no internet. Flag any
# such profile, and say whether the guard against it is in place.
check_nm_hotspot_conflict() {
    local sta=$1
    command -v nmcli >/dev/null 2>&1 || return 0

    local guard=/etc/polkit-1/rules.d/50-linux-hotspot-no-nm-share.rules
    local profile mode iface found=""

    while IFS= read -r profile; do
        [ -n "$profile" ] || continue
        mode=$(nmcli -t -f 802-11-wireless.mode connection show "$profile" 2>/dev/null | cut -d: -f2)
        [ "$mode" = "ap" ] || continue
        iface=$(nmcli -t -f connection.interface-name connection show "$profile" 2>/dev/null | cut -d: -f2)
        # An AP profile bound to our own ap0 is ours; one on the client
        # interface (or on none at all) is the destructive kind.
        if [ "$iface" != "$AP_IFACE" ]; then
            found="$found \"$profile\""
        fi
    done <<EOF
$(nmcli -t -f NAME,TYPE connection show 2>/dev/null | awk -F: '$2 ~ /wireless/ {print $1}')
EOF

    if [ -f "$guard" ]; then
        ok "GNOME Settings' own hotspot switch is blocked (it would break this one)"
    else
        meh "GNOME Settings' own hotspot switch is not blocked"
        echo "    ${C_DIM}flipping it turns $sta itself into an AP and drops the connection"
        echo "    you are sharing — reinstall to add the guard${C_RESET}"
    fi

    if [ -n "$found" ]; then
        meh "NetworkManager has its own hotspot profile:$found"
        if [ -f "$guard" ]; then
            echo "    ${C_DIM}harmless while the guard above is in place; delete it with"
            echo "    nmcli connection delete$found${C_RESET}"
        else
            echo "    ${C_DIM}delete it so nobody starts it by mistake:"
            echo "    nmcli connection delete$found${C_RESET}"
        fi
    fi
}

# Is the desktop toggle installed, and has the running GNOME session actually
# picked it up? A shell only scans for extensions at login, so installing while
# logged in leaves the tile missing until the next one — which looks exactly
# like a broken extension unless something says so out loud.
check_desktop_toggle() {
    command -v gnome-shell >/dev/null 2>&1 || return 0

    local user home dir uid state
    user="${SUDO_USER:-$(id -un)}"
    home=$(getent passwd "$user" 2>/dev/null | cut -d: -f6)
    dir="$home/.local/share/gnome-shell/extensions/$EXT_UUID"

    if [ -z "$home" ] || [ ! -d "$dir" ]; then
        meh "the GNOME quick-settings toggle is not installed for $user"
        return 0
    fi

    uid=$(id -u "$user" 2>/dev/null)
    if [ -z "$uid" ] || [ ! -S "/run/user/$uid/bus" ]; then
        ok "the GNOME toggle is installed (no active session to check against)"
        return 0
    fi

    if [ "$(id -u)" = "$uid" ]; then
        state=$(gnome-extensions info "$EXT_UUID" 2>/dev/null | awk -F': ' '/State:/{print $2}')
    else
        state=$(sudo -u "$user" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
            gnome-extensions info "$EXT_UUID" 2>/dev/null | awk -F': ' '/State:/{print $2}')
    fi

    case "$state" in
        ACTIVE)
            ok "the GNOME toggle is loaded" ;;
        ERROR)
            bad "the GNOME toggle failed to load"
            echo "    see why: journalctl --user -b 0 | grep $EXT_UUID" ;;
        "")
            meh "the GNOME toggle is installed, but this desktop session started before it was"
            echo "    ${C_DIM}log out and back in — the tile cannot appear until the shell restarts${C_RESET}" ;;
        *)
            meh "the GNOME toggle is installed but currently $state" ;;
    esac
}

# ----------------------------------------------------------------- doctor ----
cmd_doctor() {
    load_conf
    echo "${C_BOLD}linux-hotspot $VERSION — system check${C_RESET}"
    echo

    echo "${C_BOLD}system${C_RESET}"
    # shellcheck source=/dev/null
    echo "  $(. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-unknown}")"
    echo "  kernel $(uname -r)"
    echo

    echo "${C_BOLD}tools${C_RESET}"
    local t
    for t in iw hostapd dnsmasq ip; do
        if command -v "$t" >/dev/null 2>&1; then ok "$t"; else bad "$t is missing"; fi
    done
    case "$(fw_backend)" in
        iptables) ok "iptables (NAT available)" ;;
        nft)      ok "nftables (NAT available)" ;;
        none)     bad "neither iptables nor nft — clients would get no internet" ;;
    esac
    echo

    echo "${C_BOLD}radio${C_RESET}"
    local ifaces sta phy
    ifaces=$(wifi_ifaces | tr '\n' ' ')
    if [ -z "$ifaces" ]; then
        bad "no Wi-Fi interfaces found"
        return 1
    fi
    echo "  interfaces: $ifaces"
    sta=$(detect_sta)
    if [ -z "$sta" ]; then bad "could not pick a client interface"; return 1; fi
    ok "client interface: $sta"
    phy=$(sta_phy "$sta")
    ok "radio: $phy"

    local ap_phy
    ap_phy=$(pick_ap_phy "$phy")
    if [ "$ap_phy" != "$phy" ]; then
        ok "second radio $ap_phy will host the hotspot — any channel, always available"
    elif [ "$(wifi_phys | wc -l)" -le 1 ]; then
        echo "    ${C_DIM}one radio only, so the hotspot must share the client link's channel.${C_RESET}"
        echo "    ${C_DIM}A second adapter (even a cheap USB one) removes that entirely.${C_RESET}"
    fi

    if phy_supports_ap "$phy"; then
        ok "the card supports AP mode"
    else
        bad "this card does not advertise AP mode — a hotspot is not possible with this driver"
    fi

    local chan hostchan combo
    chan=$(sta_channel "$sta")

    if [ "$ap_phy" = "$phy" ]; then
        # One radio doing both jobs: the client link dictates the channel.
        combo=$(phy_ap_combination "$phy")
        if [ -n "$combo" ]; then
            ok "the driver runs an AP alongside the client link"
            if echo "$combo" | grep -q '#channels <= 1'; then
                echo "    ${C_DIM}one channel only — the hotspot must sit on the client's channel${C_RESET}"
            fi
        else
            meh "could not confirm AP + client at the same time (often still works — just try it)"
        fi
        hostchan=$chan
    else
        # The hotspot has a radio to itself, so it picks its own channel and
        # nothing the client link does can constrain it.
        hostchan=${CHANNEL:-6}
        if [ -n "$chan" ]; then
            ok "client link is on channel $chan — the hotspot does not have to follow it"
        fi
    fi

    if [ -n "$hostchan" ]; then
        [ "$ap_phy" = "$phy" ] && ok "connected on channel $chan — the hotspot will use the same channel"
        # Being allowed to *use* a channel and allowed to *start a network* on
        # it are different permissions in most countries.
        case "$(chan_allows_ap "$hostchan" "$ap_phy")" in
            yes)
                ok "$(detect_country "$ap_phy") regulations allow hosting on channel $hostchan" ;;
            no)
                bad "channel $hostchan is receive-only under $(detect_country "$ap_phy") regulations"
                echo "    ${C_DIM}a card may join a network here, but not start one${C_RESET}"
                echo "    ${C_DIM}channels this radio can host on: $(ap_capable_channels "$ap_phy")${C_RESET}" ;;
            *)
                meh "could not tell whether channel $hostchan permits hosting" ;;
        esac
    else
        meh "$sta is not connected; an uplink other than Wi-Fi is needed to share anything"
    fi
    echo

    echo "${C_BOLD}routing${C_RESET}"
    local uplink
    uplink=$(detect_uplink)
    if [ -n "$uplink" ]; then
        ok "internet arrives over $uplink"
        if [ "$uplink" = "$sta" ]; then
            if [ "$ap_phy" = "$phy" ]; then
                echo "    ${C_DIM}→ Wi-Fi to Wi-Fi on one radio: the AP is pinned to the client's channel${C_RESET}"
            else
                echo "    ${C_DIM}→ Wi-Fi to Wi-Fi, but on separate radios — no channel constraint${C_RESET}"
            fi
        fi
    else
        meh "no default route — nothing to share right now"
    fi
    echo

    echo "${C_BOLD}integration${C_RESET}"
    if command -v nmcli >/dev/null 2>&1; then
        if [ -f /etc/NetworkManager/conf.d/99-linux-hotspot.conf ]; then
            ok "NetworkManager is told to leave $AP_IFACE alone"
        else
            meh "NetworkManager may try to manage $AP_IFACE (the installer normally prevents this)"
        fi
    fi
    check_nm_hotspot_conflict "$sta"
    check_desktop_toggle
    if [ -r "$CONF" ]; then ok "config: $CONF"; else meh "no config yet: $CONF"; fi
    if systemctl list-unit-files linux-hotspot.service >/dev/null 2>&1; then
        ok "service installed ($(systemctl is-enabled linux-hotspot.service 2>/dev/null))"
    else
        meh "systemd service not installed"
    fi
    echo
    cmd_status
}

# ----------------------------------------------------------------- config ----
cmd_config() {
    need_root config
    load_conf
    local changed=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --ssid)     SSID="${2:?--ssid needs a value}"; changed=1; shift 2 ;;
            --password) PASSPHRASE="${2:?--password needs a value}"; changed=1; shift 2 ;;
            --security) SECURITY="${2:?--security needs a value}"; changed=1; shift 2 ;;
            --channel)  CHANNEL="${2:?--channel needs a value}"; changed=1; shift 2 ;;
            --country)  COUNTRY="${2:?--country needs a value}"; changed=1; shift 2 ;;
            --hidden)   HIDDEN=1; changed=1; shift ;;
            --show)     shift ;;
            *) die "unknown option for config: $1" ;;
        esac
    done

    if [ "$changed" = 0 ]; then
        echo "SSID       $SSID"
        echo "PASSPHRASE $PASSPHRASE"
        echo "SECURITY   $SECURITY"
        echo "CHANNEL    ${CHANNEL:-auto}"
        echo "COUNTRY    ${COUNTRY:-auto}"
        echo "config file: $CONF"
        return 0
    fi

    validate_credentials
    write_conf
    log "saved to $CONF"

    if systemctl is-active --quiet linux-hotspot.service 2>/dev/null; then
        log "restarting the hotspot so the change takes effect"
        systemctl restart linux-hotspot.service
    fi
}

# ------------------------------------------------------------------- help ----
cmd_help() {
    cat <<EOF
${C_BOLD}linux-hotspot $VERSION${C_RESET} — share your internet over Wi-Fi

${C_BOLD}usage${C_RESET}
  linux-hotspot <command>

${C_BOLD}commands${C_RESET}
  up                     start the hotspot
  down                   stop it and clean up
  restart                stop, then start
  roam [seconds]         pause, let you join another Wi-Fi, then come back
  status                 is it running, and who is connected
  doctor                 check whether this machine can do it, and why not
  config [options]       show or change the settings
  help                   this text
  version                print the version

${C_BOLD}config options${C_RESET}
  --ssid NAME            the network name devices will see
  --password SECRET      8-63 characters
  --security MODE        wpa2 (default) | wpa3 | mixed
  --channel N            only used when the uplink is not Wi-Fi
  --country XX           regulatory domain, e.g. GB, TZ, US
  --hidden               do not broadcast the name

${C_BOLD}day to day${C_RESET}
  sudo systemctl start linux-hotspot     # or use the GNOME quick-settings toggle
  sudo systemctl enable linux-hotspot    # bring it back automatically after a reboot

${C_BOLD}notes${C_RESET}
  When the internet arrives over the same Wi-Fi card, the hotspot is forced onto
  the channel that card is already using — one radio cannot be in two places at
  once. Everything else is detected for you.

  That is also why you cannot join a different Wi-Fi network while the hotspot
  is running: the radio is pinned to the AP's channel. Use \`linux-hotspot roam\`,
  which steps aside, waits for you to connect, and brings the hotspot back on
  the new channel.

  Config file: $CONF
EOF
}

# ------------------------------------------------------------------- main ----
case "${1:-help}" in
    up)       shift; cmd_up "$@" ;;
    down)     shift; cmd_down "$@" ;;
    restart)  shift; cmd_down >/dev/null 2>&1; cmd_up "$@" ;;
    roam)     shift; cmd_roam "$@" ;;
    status)   shift; cmd_status "$@" ;;
    doctor)   shift; cmd_doctor "$@" ;;
    config)   shift; cmd_config "$@" ;;
    version|--version|-v) echo "linux-hotspot $VERSION" ;;
    help|--help|-h) cmd_help ;;
    *) die "unknown command '$1' — try: linux-hotspot help" ;;
esac
